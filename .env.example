# ==========================================
# 环境变量配置
# ==========================================

# Vite 环境变量必须以 VITE_ 开头

# Minimax API Key (用于 AI 灵感生成)
# 1. 复制此文件为 .env
# 2. 在下方填入你的 API Key
VITE_MINIMAX_API_KEY="你的API Key"

# ==========================================
# 其他配置（可选）
# ==========================================

# APP_URL: 部署后的 URL
APP_URL="https://gui-ni.github.io/bishe-cp/"
