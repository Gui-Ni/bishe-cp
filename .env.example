# Firebase 配置
# 访问 https://console.firebase.google.com 创建项目并获取以下配置

# 1. 创建 Firebase 项目
#    访问 https://console.firebase.google.com
#    点击 "添加项目" → 输入项目名称 → 完成创建

# 2. 启用 Realtime Database
#    在项目左侧菜单选择 "Realtime Database"
#    点击 "创建数据库" → 选择地区（推荐 asia-east1）
#    选择 "以测试模式启动" → 完成

# 3. 获取配置信息
#    点击 ⚙️ 图标 → 选择 "项目设置"
#    向下滚动到 "你的应用" → 选择 Web 应用 (</>)
#    注册应用后获取配置

# Firebase 配置（必填）
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# MiniMax API（可选，用于语音识别）
VITE_MINIMAX_API_KEY=your_minimax_api_key
